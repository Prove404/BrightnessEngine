// ExtractRadiationIndices.usf
// GPU compute shader for extracting per-cell radiation indices from luminance texture
// Replaces old texture-based system with efficient buffer-based extraction (6.2× memory reduction)

#include "/Engine/Public/Platform.ush"

// ============================================================================
// Shader Parameters
// ============================================================================

uint GridDimX;              // Grid width in cells (e.g., 200)
uint GridDimY;              // Grid height in cells (e.g., 200)
uint NumCells;              // Total cells: GridDimX × GridDimY (e.g., 40,000)
float ReferenceMean;        // Reference luminance from border row (R_total) [cd/m²]
uint BorderRows;            // Number of border rows (1 if using reference tile, 0 otherwise)
float MaxRadiationIndex;    // Maximum allowed radiation index (configurable, default 5.0)

// Hock Model 3 parameters (active when MeasuredGHI_Wm2 > 0 and ClearSkyReference_Wm2 > 0)
float MeasuredGHI_Wm2;       // I = measured global horizontal irradiance [W/m²]
float ClearSkyReference_Wm2; // Is = potential clear-sky direct on horizontal [W/m²]
// Note: RTF_Etot contains Gs = UE scene radiation on slope [W/m²]
// Formula: RadiationFactor = I * (Gs/Is)

uint bUsePhysicalIrradiance; // If 1, read from RTF_Etot (W/m²); if 0, read from RTY_Total (cd/m²)

Texture2D<float> RTY_Total; // Total luminance texture (R16f single-channel) [cd/m²]
Texture2D<float> RTF_Etot;  // Physical irradiance texture (R32f single-channel) [W/m²]
RWStructuredBuffer<float> RadiationIndexBuffer; // Output: per-cell radiation indices
StructuredBuffer<uint2> CellPixelCoords; // Precomputed mapping from cell index -> pixel coordinates

float SunVisibility; // 0-1 mask derived from solar zenith

// ============================================================================
// Constants
// ============================================================================

#define DIVISION_EPSILON 1e-6

// ============================================================================
// Main Compute Shader
// ============================================================================

[numthreads(256, 1, 1)]
void ExtractRadiationIndicesCS(uint3 ThreadId : SV_DispatchThreadID)
{
    // Early exit for threads beyond grid size
    if (ThreadId.x >= NumCells)
    {
        return;
    }

    // Convert linear cell index to 2D grid coordinates
    uint CellIdx = ThreadId.x;

    // Lookup precomputed pixel coordinates for this cell
    uint2 PixelCoord = CellPixelCoords[CellIdx];
    uint PixelX = PixelCoord.x;
    uint PixelY = PixelCoord.y;

    // Sample radiation value from appropriate texture
    // Use Load() for direct pixel access (no filtering/interpolation)
    float RadiationValue = 0.0;
    if (bUsePhysicalIrradiance > 0)
    {
        // Read calibrated physical irradiance [W/m²] from RTF_Etot
        RadiationValue = RTF_Etot.Load(int3(PixelX, PixelY, 0));
    }
    else
    {
        // Read raw luminance [cd/m²] from RTY_Total
        RadiationValue = RTY_Total.Load(int3(PixelX, PixelY, 0));
    }

    // Compute dimensionless radiation index
    // Three methods based on input configuration:
    //
    // 1. Traditional reference tile method (normal sun angles):
    //    RadiationIndex = RTY_Total [cd/m²] / ReferenceMean [cd/m²]
    //    Units: [cd/m²] / [cd/m²] = dimensionless
    //
    // 2. Hock Model 3 fallback (low sun angles):
    //    RadiationFactor = I * (Gs/Is)
    //    Where: I = measured GHI, Gs = UE scene radiation, Is = potential clear-sky horizontal
    //    Then normalize by reference: RadiationIndex = RadiationFactor / ReferenceMean
    //
    float RadiationIndex = 0.0;

    if (MeasuredGHI_Wm2 > 0.0 && ClearSkyReference_Wm2 > 0.0)
    {
        // Hock Model 3: I * (Gs/Is)
        // I = MeasuredGHI_Wm2 [W/m²]
        // Gs = RadiationValue (RTF_Etot) [W/m²] - UE scene radiation on this slope
        // Is = ClearSkyReference_Wm2 [W/m²] - potential clear-sky on horizontal
        float Gs = RadiationValue;  // UE scene radiation on slope
        float Is = ClearSkyReference_Wm2;
        float I = MeasuredGHI_Wm2;

        // Compute slope-corrected measured radiation: I * (Gs/Is)
        float RadiationFactor_Wm2 = I * (Gs / (Is + DIVISION_EPSILON));

        // Normalize to get dimensionless index
        // Use reference tile luminance converted to equivalent W/m² scale
        // For now, normalize by I (the measured GHI) to get relative slope effect
        RadiationIndex = (Gs / (Is + DIVISION_EPSILON));
    }
    else
    {
        // Traditional normalization
        float Reference = (ClearSkyReference_Wm2 > 0.0) ? ClearSkyReference_Wm2 : ReferenceMean;

        // Apply Hock (1999) low sun angle prescription: suppress ratio when reference is very low
        // This prevents spikes when reference tile is shadowed but cells receive diffuse light
        // Use a minimum threshold to detect when reference is unreliable (e.g., < 0.1 cd/m²)
        const float MinReferenceThreshold = 0.1;
        if (Reference < MinReferenceThreshold)
        {
            // Reference too low (shadowed/unreliable) - suppress the ratio
            RadiationIndex = 0.0;
        }
        else
        {
            RadiationIndex = RadiationValue / (Reference + DIVISION_EPSILON);
        }
    }

    // Clamp to configured maximum (default 5.0, adjustable for terrain complexity)
    RadiationIndex = clamp(RadiationIndex, 0.0, MaxRadiationIndex) * SunVisibility;

    // Write to output buffer (direct indexed access)
    RadiationIndexBuffer[CellIdx] = RadiationIndex;
}
